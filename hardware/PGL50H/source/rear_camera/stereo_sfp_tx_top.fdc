create_clock -name {sys_clk} [get_ports {sys_clk}] -period {20.000} -waveform {0.000 10.000}
create_generated_clock -name {ddrphy_clkin} -source [get_ports {sys_clk}] [get_pins {u_video_pipeline.u_DDR3_50H.I_GTP_CLKDIV/CLKDIVOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {8}
create_generated_clock -name {ioclk0} -source [get_ports {sys_clk}] [get_pins {u_video_pipeline.u_DDR3_50H.I_GTP_IOCLKBUF_0/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk1} -source [get_ports {sys_clk}] [get_pins {u_video_pipeline.u_DDR3_50H.I_GTP_IOCLKBUF_1/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk2} -source [get_ports {sys_clk}] [get_pins {u_video_pipeline.u_DDR3_50H.I_GTP_IOCLKBUF_2/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}
create_generated_clock -name {ioclk_gate_clk} -source [get_ports {sys_clk}] [get_pins {u_video_pipeline.u_DDR3_50H.u_clkbufg_gate/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {8}
set_clock_uncertainty {0.200} [get_clocks {ddrphy_clkin}]  -setup -hold
set_clock_groups -name ref_clk -asynchronous -group [get_clocks {sys_clk}]
set_clock_groups -name ioclk0 -asynchronous -group [get_clocks {ioclk0}]
set_clock_groups -name ioclk1 -asynchronous -group [get_clocks {ioclk1}]
set_clock_groups -name ioclk2 -asynchronous -group [get_clocks {ioclk2}]
set_clock_groups -name ioclk_gate_clk -asynchronous -group [get_clocks {ioclk_gate_clk}]
define_attribute {i:u_video_pipeline.u_DDR3_50H.u_ipsxb_ddrphy_pll_0.u_pll_e3} {PAP_LOC} {PLL_158_199}
define_attribute {i:u_video_pipeline.u_DDR3_50H.u_ipsxb_ddrphy_pll_1.u_pll_e3} {PAP_LOC} {PLL_158_179}
define_attribute {i:u_video_pipeline.u_DDR3_50H.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate} {PAP_LOC} {CLMA_150_192:FF3}
create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_nets {u_video_pipeline.u_pll.clkout0}] -master_clock [get_clocks {sys_clk}] -multiply_by {297} -divide_by {100}
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_nets {u_video_pipeline.u_pll.clkout1}] -master_clock [get_clocks {sys_clk}] -multiply_by {1} -divide_by {5}
create_generated_clock -name {clk_25M} -source [get_ports {sys_clk}] [get_nets {u_video_pipeline.u_pll.clkout2}] -master_clock [get_clocks {sys_clk}] -multiply_by {1} -divide_by {2}
set_clock_groups -name cfg_clk -asynchronous -group [get_clocks {cfg_clk}]
set_clock_groups -name clk_25M -asynchronous -group [get_clocks {clk_25M}]
set_clock_groups -name ddrphy_clkin -asynchronous -group [get_clocks {ddrphy_clkin}]
set_clock_groups -name pix_clk -asynchronous -group [get_clocks {pix_clk}]
define_attribute {i:u_video_pipeline.u_hsst_core.U_GTP_HSST_WRAPPER.U_GTP_HSST} {PAP_LOC} {HSST_88_340}
create_clock -name {p_clk2core_tx_2} [get_nets {u_video_pipeline.u_hsst_core.o_p_clk2core_tx_2}] -period {8} -waveform {0 4}
create_clock -name {p_clk2core_rx_2} [get_nets {u_video_pipeline.u_hsst_core.o_p_clk2core_rx_2}] -period {8} -waveform {0 4}
set_clock_groups -name p_clk2core_tx_2 -asynchronous -group [get_clocks {p_clk2core_tx_2}]
set_clock_groups -name p_clk2core_rx_2 -asynchronous -group [get_clocks {p_clk2core_rx_2}]

# HDMI_IN1 像素时钟约束（stereo 模式停用：板上不接视频源，该时钟实际不存在，
# 约束保留只为端口合法；源同步输入延时需按实际板卡验证）
create_clock -name {hdmi_input_clk} [get_ports {pixclk_in}] -period {6.734} -waveform {0 3.367}
set_clock_groups -name hdmi_input_async -asynchronous -group [get_clocks {hdmi_input_clk}]

#==============================================================================
